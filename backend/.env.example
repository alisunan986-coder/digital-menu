# PostgreSQL connection string (Prisma reads this)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/digital_menu?schema=public"

# Express server port
PORT=5000

# ── Email notifications for new feedback (SMTP) ──────────────
# Works with ANY SMTP provider — just change these values:
#   Gmail:     SMTP_HOST="smtp.gmail.com"   (needs 2-Step Verification + an App Password)
#   Outlook:   SMTP_HOST="smtp-mail.outlook.com"
#   Brevo:     SMTP_HOST="smtp-relay.brevo.com"
#   SendGrid:  SMTP_HOST="smtp.sendgrid.net"  (username is the literal string "apikey")
#   Resend:    SMTP_HOST="smtp.resend.com"
# While these are empty, feedback is still saved — the email is skipped silently.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
# Google shows app passwords as "abcd efgh ijkl mnop" — either form works,
# the server strips the whitespace before authenticating.
SMTP_PASS="your-app-password"

# Where feedback notifications are delivered
FEEDBACK_EMAIL_TO="owner@example.com"

# Optional "from" address — defaults to SMTP_USER when omitted
# FEEDBACK_EMAIL_FROM="you@gmail.com"
